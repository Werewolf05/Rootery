  lcdNeedsRedraw = true;
}

// ===============================================
// Loop
// ===============================================
void loop() {
  unsigned long now = millis();

  // Serial command interface for manual testing:
  if (Serial.available()) {
    char c = (char)Serial.read();
    if (c == 'p') { setPump(!pumpOn); }
    else if (c == 'P') { setPump(true); }
    else if (c == 'o') { setPump(false); }
    else if (c == 's') { setSprinkler(!sprinklerOn); }
    else if (c == 'S') { setSprinkler(true); }
    else if (c == 'x') { setSprinkler(false); }
    else if (c == 'u') {
      if (WiFi.status() == WL_CONNECTED) {
        bool ok = pushToSupabase();
        Serial.printf("[Push] manual sync %s\n", ok ? "OK" : "FAIL");
        if (ok) stateSyncPending = false;
      } else Serial.println(F("[Push] No WiFi"));
    }
  }

  handleButton(btnPump,      onPumpShort,      onPumpLong);
  handleButton(btnSprinkler, onSprinklerShort, onSprinklerLong);
  handleButton(btnReset,     onResetShort,     onResetLong);

  if (stateSyncPending) {
    if (WiFi.status() == WL_CONNECTED) {
      if (pushToSupabase()) {
        stateSyncPending = false;
        lastSupabasePush = now;
      }
    } else {
      connectWiFi();
    }
  }

  if (now - lastSensorRead >= SENSOR_INTERVAL) {
    lastSensorRead = now;
    readSensors();
    runSprinklerAutomation();
    checkTankAlerts();
    lcdNeedsRedraw = true;
  }

  if (!stateSyncPending && now - lastSupabasePush >= SUPABASE_INTERVAL) {
    lastSupabasePush = now;
    if (WiFi.status() == WL_CONNECTED) pushToSupabase();
    else connectWiFi();
  }

  if (now - lastCommandPoll >= COMMAND_POLL_INTERVAL) {
    lastCommandPoll = now;
    if (WiFi.status() == WL_CONNECTED) pollCommandsFromSupabase();
  }

  if (now - lastPageSwitch >= LCD_PAGE_INTERVAL) {
    lastPageSwitch = now;
    lcdPage = (lcdPage + 1) % 3;
    lcd.clear();
    lcdNeedsRedraw = true;
  }

  if (lcdNeedsRedraw) { updateLCD(); lcdNeedsRedraw = false; }
}

// ===============================================
// Sensor orchestration
// ===============================================
void readSensors() {
  readRealSensors();
  generateManufacturedData();

  Serial.printf(
    "[Sensors] AirT=%.1fC(REAL) Hum=%.0f%%(REAL) Main=%.0f%%(REAL) Spr=%.0f%%(REAL)"
    " | WatT=%.1fC(MFG) pH=%.2f(MFG) TDS=%.0f(MFG)\n",
    data.airTemp, data.humidity, data.mainTankPct, data.sprTankPct,
    data.waterTemp, data.ph, data.tds);
}

// Reads DHT22 (air temp + humidity) and both ultrasonics.
void readRealSensors() {
  // --- DHT22 ---
  float h = dht.readHumidity();
  float t = dht.readTemperature();
  // Debug: print raw DHT readings so we can see NAN or spurious values
  Serial.printf("[DHT22] raw temp=%.3f hum=%.3f isnan_t=%d isnan_h=%d\n", t, h, isnan(t), isnan(h));
  if (!isnan(h) && !isnan(t)) {
    data.airTemp  = t;
    data.humidity = h;
    Serial.printf("[DHT22] AirT=%.1fC Hum=%.0f%%\n", t, h);
  } else {
    Serial.println(F("[DHT22] Read failed - keeping last value"));
  }

  // --- Ultrasonic 1 (main tank) ---
  float d1 = measureDistance(PIN_TRIG1, PIN_ECHO1);
  if (d1 > 0.0f && d1 < MAIN_TANK_HEIGHT_CM + 5.0f) {
    data.mainTankPct = tankPercent(d1, MAIN_TANK_HEIGHT_CM);
    Serial.printf("[US1] dist=%.1fcm -> main tank %.0f%%\n", d1, data.mainTankPct);
  } else {
    Serial.printf("[US1] Bad read (%.1f) - keeping last value\n", d1);
  }

  // --- Ultrasonic 2 (sprinkler tank) ---
  float d2 = measureDistance(PIN_TRIG2, PIN_ECHO2);
  if (d2 > 0.0f && d2 < SPRINKLER_TANK_HEIGHT_CM + 5.0f) {
    data.sprTankPct = tankPercent(d2, SPRINKLER_TANK_HEIGHT_CM);
    Serial.printf("[US2] dist=%.1fcm -> spr tank %.0f%%\n", d2, data.sprTankPct);
  } else {
    Serial.printf("[US2] Bad read (%.1f) - keeping last value\n", d2);
  }
}

// Manufactured: water temp, pH, TDS — smooth sinusoidal drift.
// Water temp is loosely correlated with real air temp for plausibility.
void generateManufacturedData() {
  const float t  = millis() / 1000.0f;
  const float nA = random(-20, 21) / 100.0f;
  const float nB = random(-8,   9) / 100.0f;
  const float nC = random(-50, 51) / 1.0f;

  // Water temp: tracks ~2-3°C below air temp with slow drift
  float wtBase   = (data.airTemp - 2.5f) + 0.6f * sinf(t / 95.0f + 0.7f) + nA;
  data.waterTemp = clampf(wtBase, 18.0f, 28.0f);

  // pH: slow drift in healthy hydroponic range (5.6–6.6)
  float phBase = 6.05f + 0.18f * sinf(t / 120.0f + 0.2f) + nB;
  data.ph      = clampf(phBase, 5.6f, 6.6f);

  // TDS: moderate oscillation in typical nutrient range (600–1200 ppm)
  float tdsBase = 850.0f + 130.0f * sinf(t / 110.0f + 1.1f) + nC;
  data.tds      = clampf(tdsBase, 600.0f, 1200.0f);
}

// ===============================================
// Ultrasonic helpers
// ===============================================
float measureDistance(uint8_t trig, uint8_t echo) {
  digitalWrite(trig, LOW);  delayMicroseconds(2);
  digitalWrite(trig, HIGH); delayMicroseconds(10);
  digitalWrite(trig, LOW);
  long dur = pulseIn(echo, HIGH, 30000);
  if (dur == 0) {
    Serial.printf("[US] pulseIn timeout trig=%u echo=%u\n", trig, echo);
    return -1.0f;
  }
  float dist = dur * 0.0343f / 2.0f;
  Serial.printf("[US] pulseIn dur=%ldus -> %.1fcm (trig=%u echo=%u)\n", dur, dist, trig, echo);
  return dist;
}

float tankPercent(float distCm, float tankHeightCm) {
  float level = tankHeightCm - distCm;
  return constrain((level / tankHeightCm) * 100.0f, 0.0f, 100.0f);
}

// ===============================================
// Sprinkler automation FSM
// ===============================================
void runSprinklerAutomation() {
  unsigned long now = millis();
  bool tooHot = (data.airTemp > AIR_TEMP_THRESHOLD || data.waterTemp > WATER_TEMP_THRESHOLD);

  switch (autoState) {
    case AUTO_IDLE:
      if (tooHot) {
        Serial.println(F("[Auto] High temp - starting sprinkler"));
        setSprinkler(true);
        autoTimer = now;
        setAutoState(AUTO_RUNNING);
      }
      break;
    case AUTO_RUNNING:
      if (now - autoTimer >= SPRINKLER_RUN_MS) {
        Serial.println(F("[Auto] Run complete - waiting 30 min"));
        setSprinkler(false);
        autoTimer = now;
        setAutoState(AUTO_WAITING);
      }
      break;
    case AUTO_WAITING:
      if (now - autoTimer >= SPRINKLER_WAIT_MS) {
        if (tooHot) {
          Serial.println(F("[Auto] Still hot - running again"));
          setSprinkler(true);
          autoTimer = now;
          setAutoState(AUTO_RUNNING);
        } else {
          Serial.println(F("[Auto] Temp normalised - idle"));
          setAutoState(AUTO_IDLE);
        }
      }
      break;
    }
  }

// ===============================================
// Tank alerts
// ===============================================
void checkTankAlerts() {
  unsigned long now = millis();
  if (data.mainTankPct < TANK_LOW_PCT && (now - lastMainTankAlert > ALERT_COOLDOWN_MS)) {
    lastMainTankAlert = now;
    Serial.printf("[Warn] Main tank low: %.0f%%\n", data.mainTankPct);
  }
  if (data.sprTankPct < TANK_LOW_PCT && (now - lastSprTankAlert > ALERT_COOLDOWN_MS)) {
    lastSprTankAlert = now;
    Serial.printf("[Warn] Sprinkler tank low: %.0f%%\n", data.sprTankPct);
  }
}

// ===============================================
// Actuators
// ===============================================
void setPump(bool on) {
  if (pumpOn == on) return;
  pumpOn = on;
  digitalWrite(PIN_PUMP_RELAY, on ? RELAY_ON : RELAY_OFF);
  Serial.printf("[Pump] %s\n", on ? "ON" : "OFF");
  stateSyncPending = true;
  lcdNeedsRedraw = true;
}

void setSprinkler(bool on) {
  if (sprinklerOn == on) return;
  sprinklerOn = on;
  digitalWrite(PIN_SPRINKLER_RELAY, on ? RELAY_ON : RELAY_OFF);
  Serial.printf("[Sprinkler] %s\n", on ? "ON" : "OFF");
  stateSyncPending = true;
  lcdNeedsRedraw = true;
}

void setAutoState(SprinklerAutoState state) {
  if (autoState == state) return;
  autoState = state;
  stateSyncPending = true;
  lcdNeedsRedraw = true;
}

